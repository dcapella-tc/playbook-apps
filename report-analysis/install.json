{
  "allowOnDemand": true,
  "appId": "6e26ba55-0300-5462-aca7-ea049494c8a5",
  "category": "Utility",
  "displayName": "Report Analysis",
  "features": [
    "CALSettings",
    "aotExecutionEnabled",
    "appBuilderCompliant",
    "fileParams",
    "redisPasswordSupport",
    "runtimeVariables"
  ],
  "languageVersion": "3.11",
  "listDelimiter": "|",
  "minServerVersion": "7.2.0",
  "note": "Beta. Analyze plain-text report content via CAL Document Analysis, then create or update a ThreatConnect Report with extracted enrichment.\n",
  "params": [
    {
      "label": "Owner Name",
      "name": "owner_name",
      "note": "ThreatConnect owner for the report and indicators.",
      "playbookDataType": [
        "String"
      ],
      "required": true,
      "sequence": 1,
      "type": "String",
      "validValues": [
        "${TEXT}"
      ],
      "viewRows": 1
    },
    {
      "label": "Report Name",
      "name": "report_name",
      "note": "Name of the ThreatConnect Report group to create or update.",
      "playbookDataType": [
        "String"
      ],
      "required": true,
      "sequence": 2,
      "type": "String",
      "validValues": [
        "${TEXT}"
      ],
      "viewRows": 1
    },
    {
      "label": "content",
      "name": "content",
      "note": "Plain-text report content sent to CAL Document Analysis for enrichment.",
      "playbookDataType": [
        "String"
      ],
      "required": true,
      "sequence": 3,
      "type": "String",
      "validValues": [
        "${TEXT}"
      ],
      "viewRows": 6
    }
  ],
  "playbook": {
    "outputVariables": [
      {
        "name": "report.xid",
        "type": "String"
      },
      {
        "name": "report.indicators.count",
        "type": "String"
      },
      {
        "name": "report.groups.count",
        "type": "String"
      }
    ],
    "type": "Utility"
  },
  "programLanguage": "PYTHON",
  "programMain": "run.py",
  "programVersion": "0.1.0-beta",
  "runtimeLevel": "Playbook",
  "sdkVersion": "4.0.1"
}
