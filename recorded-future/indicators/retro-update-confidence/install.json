{
  "allowOnDemand": true,
  "appId": "6e0cebfa-24df-4a00-b75f-2395ce08500c",
  "category": "Utility",
  "displayName": "RF Retro Update Confidence",
  "features": [
    "aotExecutionEnabled",
    "appBuilderCompliant",
    "fileParams",
    "redisPasswordSupport",
    "runtimeVariables"
  ],
  "languageVersion": "3.11",
  "listDelimiter": "|",
  "minServerVersion": "7.2.0",
  "note": "Retrieve indicators matching a TQL query and set each indicator's confidence to the integer value of its Risk List attribute.\n",
  "params": [
    {
      "label": "TQL",
      "name": "tql",
      "note": "ThreatConnect Query Language used to select indicators. Include ownerName in the TQL when the job should be owner-scoped.",
      "playbookDataType": [
        "String"
      ],
      "required": true,
      "sequence": 1,
      "type": "String",
      "validValues": [
        "${TEXT}"
      ],
      "viewRows": 4
    }
  ],
  "playbook": {
    "outputVariables": [
      {
        "name": "indicators.updated",
        "type": "String"
      },
      {
        "name": "indicators.skipped",
        "type": "String"
      },
      {
        "name": "indicators.failed",
        "type": "String"
      }
    ],
    "type": "Utility"
  },
  "programLanguage": "PYTHON",
  "programMain": "run.py",
  "programVersion": "1.0.0",
  "runtimeLevel": "Playbook",
  "sdkVersion": "4.0.1"
}
